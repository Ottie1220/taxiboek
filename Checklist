  </div>

  <div class="tip-box">
    <h3>💡 Tip — stuur bonnen direct in</h3>
    <p>Maak een foto van je bon zodra je iets koopt en stuur hem meteen via WhatsApp. Zo raak je nooit een bon kwijt en hoef je aan het einde van het kwartaal niets meer terug te zoeken. Jij houdt in je WhatsApp-chat ook zelf een overzicht bij!</p>
  </div>

  <button class="reset-btn" onclick="resetAll()">↺ Alles opnieuw beginnen</button>

</div>

<a href="https://wa.me/31600000000" class="whatsapp-float">
  📱 Stuur op via WhatsApp
</a>

<footer>
  &copy; 2026 TaxiBoek &middot; <a href="index.html" style="color:var(--muted)">Terug naar home</a>
</footer>

<script>
const cats = ['inkomsten', 'brandstof', 'auto', 'overig'];

function toggle(item) {
  item.classList.toggle('done');
  updateProgress();
}

function updateProgress() {
  const all = document.querySelectorAll('.check-item');
  const done = document.querySelectorAll('.check-item.done');
  const total = all.length;
  const checked = done.length;
  const pct = Math.round((checked / total) * 100);

  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-text').textContent = checked;
  document.getElementById('progress-total').textContent = total;

  // Per categorie teller
  cats.forEach(cat => {
    const catAll = document.querySelectorAll(`[data-cat="${cat}"]`).length;
    const catDone = document.querySelectorAll(`[data-cat="${cat}"].done`).length;
    const el = document.getElementById(`count-${cat}`);
    if (el) el.textContent = `${catDone} / ${catAll}`;
  });

  // Done banner
  const banner = document.getElementById('done-banner');
  if (checked === total) {
    banner.classList.add('show');
    banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else {
    banner.classList.remove('show');
  }
}

function resetAll() {
  document.querySelectorAll('.check-item.done').forEach(i => i.classList.remove('done'));
  updateProgress();
}

// Init
window.addEventListener('load', updateProgress);
</script>

</body>
</html>

      <div class="cat-title">Auto kosten</div>
      <div class="cat-count" id="count-auto"></div>
    </div>
    <div class="check-list">
      <div class="check-item" onclick="toggle(this)" data-cat="auto">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Lease factuur</div>
          <div class="check-sub">Maandelijkse factuur van je leasemaatschappij</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="auto">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Verzekeringspremie</div>
          <div class="check-sub">Factuur of bankafschrift van je verzekering</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="auto">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Onderhoud & reparatie bonnen</div>
          <div class="check-sub">Garage facturen, APK, banden — foto direct opsturen</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="auto">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Wasstraat bonnen</div>
          <div class="check-sub">Foto van de bon direct na het wassen opsturen</div>
        </div>
      </div>
    </div>
  </div>

  <hr class="divider">

  <!-- OVERIG -->
  <div class="category">
    <div class="cat-header">
      <div class="cat-icon" style="background:#f0fdf4">📋</div>
      <div class="cat-title">Overige zakelijke kosten</div>
      <div class="cat-count" id="count-overig"></div>
    </div>
    <div class="check-list">
      <div class="check-item" onclick="toggle(this)" data-cat="overig">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">TTO kosten (Taxistad, Hallo etc.)</div>
          <div class="check-sub">Facturen van je taxi-platform organisatie</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="overig">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Bankkosten</div>
          <div class="check-sub">Bankafschrift of factuur van je bank</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="overig">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Overige zakelijke bonnen</div>
          <div class="check-sub">Alles wat je zakelijk hebt uitgegeven — stuur het op, wij kijken wat aftrekbaar is</div>
        </div>
      </div>

    </div>
    <div class="check-list">
      <div class="check-item" onclick="toggle(this)" data-cat="inkomsten">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Uber uitbetalingsoverzicht</div>
          <div class="check-sub">PDF of Excel — alle maanden van het kwartaal</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="inkomsten">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Bolt afrekening</div>
          <div class="check-sub">PDF of Excel — alle maanden van het kwartaal</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="inkomsten">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">iZettle / myPOS / SumUp verkooprapport</div>
          <div class="check-sub">PDF via PayPal of je betaalapp — per maand</div>
        </div>
      </div>
      <div class="check-item" onclick="toggle(this)" data-cat="inkomsten">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Andere inkomsten (indien van toepassing)</div>
          <div class="check-sub">Losse ritten, contante betalingen, andere platforms — alles is welkom!</div>
        </div>
      </div>
    </div>
  </div>

  <hr class="divider">

  <!-- TANKKOSTEN -->
  <div class="category">
    <div class="cat-header">
      <div class="cat-icon" style="background:#fefce8">⛽</div>
      <div class="cat-title">Brandstof & laden</div>
      <div class="cat-count" id="count-brandstof"></div>
    </div>
    <div class="check-list">
      <div class="check-item" onclick="toggle(this)" data-cat="brandstof">
        <div class="check-box"><span class="check-box-tick">✓</span></div>
        <div class="check-content">
          <div class="check-label">Tankbonnen</div>
          <div class="check-sub">Maak een foto van de bon en stuur hem direct via WhatsApp — zo raak je hem nooit kwijt</div>
